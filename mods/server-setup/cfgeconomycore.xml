<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<economycore>
    <classes>
        <rootclasses>
            <rootclass name="Static" reportMemoryLeak="0"/>
            <rootclass name="Vertical" reportMemoryLeak="0"/>
        </rootclasses>
    </classes>

    <ce folder="db">
        <file name="types.xml" type="types" />
        <file name="events.xml" type="events" />
        <file name="globals.xml" type="globals" />
    </ce>

    <defaults>
        <default name="Missions" folder="." file="cfgmissions.xml" />
        <default name="CfgEventSpawns" folder="." file="cfgeventspawns.xml" />
        <default name="CfgSpawnableTypes" folder="." file="cfgspawnabletypes.xml" />
        <!-- Note: "cfgrandompresnce.xml" is the actual vanilla DayZ filename — the unusual spelling is intentional -->
        <default name="CfgRandomPresence" folder="." file="cfgrandompresnce.xml" />
        <default name="CfgWeather" folder="." file="cfgweather.xml" />
        <default name="CfgPlayerSpawnPoints" folder="." file="cfgplayerspawnpoints.xml" />
        <default name="CfgIgnoreList" folder="." file="cfgIgnoreList.xml" />
        <default name="CfgLimitsDefinition" folder="." file="cfglimitsdefinition.xml" />
        <default name="CfgLimitsDefinitionUser" folder="." file="cfglimitsdefinitionuser.xml" />
    </defaults>
</economycore>
