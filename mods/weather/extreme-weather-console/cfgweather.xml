<!--
  ============================================================
  EXTREME WEATHER — CONSOLE EDITION
  cfgweather.xml  |  DayZ Console / Nitrado / PC compatible
  ============================================================

  Drop this file into your mission folder alongside types.xml.
  No scripts, no mods, no .bikey files required.
  Works on Xbox, PlayStation, Nitrado, and PC servers.

  Mission folder location (default maps):
    mpmissions/dayzOffline.chernarusplus/cfgweather.xml
    mpmissions/dayzOffline.enoch/cfgweather.xml

  DESIGN PHILOSOPHY
  ~5-10 %   rare crystal-clear PERFECT days (min overcast, min fog, min rain)
  ~25-30 %  heavy fog walls, near-whiteout, visibility-killing conditions
  ~30-35 %  harsh rain storms, downpours, miserable heavy overcast
  ~20-25 %  mixed/transitional weather (overcast building or clearing)
  ~5-10 %   calm-but-gloomy, no precipitation but oppressive cloud

  Weather cycles fast (5-30 min average) so players experience multiple
  dramatic shifts within a single play session.

  SCHEMA REFERENCE (official DayZ schema — console and PC compatible)
  overcast  = cloud cover 0.0 (clear) to 1.0 (fully overcast)
  fog       = fog density 0.0 (clear) to 1.0 (near-zero visibility)
  rain      = precipitation 0.0 (dry) to 1.0 (maximum downpour)
  wind      = windMagnitude (m/s) + windDirection (radians)

  Each weather block:
    <current actual="..." time="..." duration="..." />
      - actual:   starting value
      - time:     seconds to reach that value
      - duration: how long to hold before next transition
    <limits min="..." max="..." />      - absolute clamps on the value
    <timelimits min="..." max="..." />  - seconds between transitions
    <changelimits min="..." max="..." /> - magnitude of each transition swing
  rain also supports:
    <thresholds min="..." max="..." end="..." />
      - min/max: overcast level required for rain to occur
      - end:     seconds for rain to stop when overcast drops out of range
  ============================================================
-->
<weather reset="0" enable="1">

    <!--
      ══════════════════════════════════════════════
      OVERCAST — cloud cover
      ══════════════════════════════════════════════
      min 0.0  → allows rare crystal-clear perfect days
      max 1.0  → allows full pitch-black overcast
      Wide changelimits (0.0–1.0) let the engine jump between
      sunshine and total cloud cover in a single transition.
      Short timelimits keep the drama frequent (5–30 min cycles).
    -->
    <overcast>
        <current actual="0.75" time="120" duration="300" />
        <!-- Full range — allow everything from clear to max cloud -->
        <limits min="0.0" max="1.0" />
        <!-- 5–30 min cycles for frequent dramatic shifts -->
        <timelimits min="300" max="1800" />
        <!-- Full swing per transition — sunshine to storm in one step -->
        <changelimits min="0.0" max="1.0" />
    </overcast>

    <!--
      ══════════════════════════════════════════════
      FOG — visibility impairment  ★ KEY SYSTEM ★
      ══════════════════════════════════════════════
      The primary hazard driver. Fog walls rolling in from
      nowhere collapse navigation and shrink PvP ranges to
      knife-fight distances. Getting lost in the wilderness
      becomes genuinely lethal.

      min 0.0  → zero fog during those rare perfect days
      max 1.0  → absolute near-zero visibility whiteout
      Very short timelimits make fog unpredictable and sudden.
      Full changelimits allow instant fog walls — clear to
      whiteout in a single transition.
    -->
    <fog>
        <current actual="0.05" time="120" duration="180" />
        <!-- Full range — zero fog to absolute whiteout -->
        <limits min="0.0" max="1.0" />
        <!-- 4–20 min — fog is unpredictable and sudden -->
        <timelimits min="240" max="1200" />
        <!-- Full swing — clear to whiteout in one transition -->
        <changelimits min="0.0" max="1.0" />
    </fog>

    <!--
      ══════════════════════════════════════════════
      RAIN — precipitation intensity
      ══════════════════════════════════════════════
      min 0.0  → dry periods and perfect days
      max 1.0  → maximum downpour / torrential rain
      Short timelimits allow sudden storm onset. Wet gear
      accelerates cold stat loss — caught in the open is
      genuinely dangerous. Requires overcast ≥ 0.55 to rain.
    -->
    <rain>
        <current actual="0.0" time="60" duration="120" />
        <!-- Full range — dry to maximum downpour -->
        <limits min="0.0" max="1.0" />
        <!-- 5–25 min — storms arrive and leave quickly -->
        <timelimits min="300" max="1500" />
        <!-- Full swing — instant torrential onset possible -->
        <changelimits min="0.0" max="1.0" />
        <!-- Rain only when overcast ≥ 0.55; clears fast (60 s) when overcast drops -->
        <thresholds min="0.55" max="1.0" end="60" />
    </rain>

    <!--
      ══════════════════════════════════════════════
      WIND MAGNITUDE — wind speed in m/s
      ══════════════════════════════════════════════
      min 0.0   → dead calm during perfect days
      max 30.0  → hurricane-force gusts
      Starts moderate (8 m/s) and swings wildly.
      Combined with heavy rain = genuinely punishing storms.
    -->
    <windMagnitude>
        <current actual="8.0" time="120" duration="240" />
        <!-- Dead calm to hurricane-force -->
        <limits min="0.0" max="30.0" />
        <!-- 3–15 min wind shifts -->
        <timelimits min="180" max="900" />
        <!-- Large swings for chaotic, unpredictable gusts -->
        <changelimits min="0.0" max="20.0" />
    </windMagnitude>

    <!--
      ══════════════════════════════════════════════
      WIND DIRECTION — angle in radians
      ══════════════════════════════════════════════
      Full rotational range (−π to +π).
      Direction shifts frequently to keep wind chaotic.
    -->
    <windDirection>
        <current actual="0.0" time="120" duration="240" />
        <limits min="-3.14" max="3.14" />
        <!-- Frequent direction changes — 1–6 min -->
        <timelimits min="60" max="360" />
        <changelimits min="-1.0" max="1.0" />
    </windDirection>

    <!--
      ══════════════════════════════════════════════
      STORM — lightning frequency
      ══════════════════════════════════════════════
      Activates when overcast ≥ 0.85 (deep storm conditions).
      Dense lightning (1.0) with 30 s intervals for
      dramatic storm atmosphere.
    -->
    <storm density="1.0" threshold="0.85" timeout="30" />

</weather>
