<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
    cfgeventspawns.xml — Realistic Wildlife Overhaul (Chernarus)
    =============================================================
    INSTALL PATH: mpmissions/dayzOffline.chernarusplus/cfgeventspawns.xml

    Vanilla Chernarus animal entries are empty self-closing tags — the engine
    distributes limit=child events automatically across map terrain.

    AnimalBear is the only addition: vanilla has it disabled (nominal=0).
    We enable it via bear_territories.xml which provides spawn positions
    (required because AnimalBear uses limit=custom).

    AmbientFox/Hare/Hen are proximity-based (distanceradius) — no entry needed.

    Source: BohemiaInteractive/DayZ-Central-Economy
      dayzOffline.chernarusplus/cfgeventspawns.xml
-->
<eventposdef>

    <event name="AnimalDeer" />
    <event name="AnimalCow" />
    <event name="AnimalSheep" />
    <event name="AnimalRoeDeer" />
    <event name="AnimalWolf" />
    <event name="AnimalWildBoar" />
    <event name="AnimalGoat" />
    <event name="AnimalPig" />
    <event name="AnimalBear">
        <file>env/bear_territories.xml</file>
    </event>

</eventposdef>
