<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
    cfgeventspawns.xml — Realistic Wildlife Overhaul (Chernarus)
    =============================================================
    INSTALL PATH: mpmissions/dayzOffline.chernarusplus/cfgeventspawns.xml

    The engine links each event to its territory file by naming convention:
      Strip "Animal" or "Ambient" prefix, lowercase, append "_territories.xml"
      e.g. AnimalDeer -> deer_territories.xml
           AmbientFox -> fox_territories.xml

    All entries are empty tags — territory files in env/ are loaded automatically.
-->
<eventposdef>

    <event name="AmbientFox" />
    <event name="AmbientHare" />
    <event name="AmbientHen" />
    <event name="AnimalBear" />
    <event name="AnimalCow" />
    <event name="AnimalDeer" />
    <event name="AnimalGoat" />
    <event name="AnimalPig" />
    <event name="AnimalRoeDeer" />
    <event name="AnimalSheep" />
    <event name="AnimalWildBoar" />
    <event name="AnimalWolf" />

</eventposdef>
