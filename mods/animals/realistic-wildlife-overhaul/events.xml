<?xml version="1.0" encoding="UTF-8"?>
<!--
    events.xml — Realistic Wildlife Overhaul
    ==========================================
    Full replacement events.xml covering all animal spawn events for
    DayZ Chernarus+ (dayzOffline.chernarusplus).

    INSTALL PATH: mpmissions/dayzOffline.chernarusplus/db/events.xml

    DESIGN PHILOSOPHY:
    - Hunting is a core survival mechanic: prey animals are abundant and spread
      across the entire map so players always have something to hunt.
    - Predators follow prey: wolves and bears are more common, territorial, and
      distributed across the whole map — not just the far north like vanilla.
    - Mixed pack sizes: wolves range from small 2-3 animal scouts to large 8-12
      animal mega-packs for variety and tension.
    - Farm animals at every settlement: hens, cattle, sheep, pigs near every
      village and farm so early-game players have food options.
    - Post-apocalyptic ecology: wildlife populations have grown unchecked since
      the outbreak. Animals are bolder and more numerous than pre-outbreak.

    NOMINAL COUNTS (active on map at any time):
      Hare         80  — most common, everywhere
      Roe Deer     50  — very common, rural/forest
      Red Deer     35  — common, inland/meadows
      Wild Boar    30  — moderately common, woodlands
      Hen          60  — common, settlements/farms
      Cattle       25  — farms and open fields
      Sheep/Goat   20  — farms and hillsides
      Pig          20  — mostly farms
      DomAnimals   25  — mixed, near villages
      Fox          30  — forest edges and farms
      Wolf         20  — predator, spread entire map (was 8 in vanilla)
      Bear         15  — predator, rivers/forests/food sources

    NOTE: Lifetime values are in seconds.
    NOTE: Children min/max control group sizes per spawn event.
-->
<events>

    <!-- ============================================================ -->
    <!-- HARES — Most widespread prey animal                          -->
    <!-- Everywhere: fields, forest edges, coast, villages            -->
    <!-- ============================================================ -->
    <event name="AnimalHare">
        <nominal>80</nominal>
        <min>50</min>
        <max>120</max>
        <lifetime>3600</lifetime>
        <restock>0</restock>
        <saferadius>200</saferadius>
        <distanceradius>0</distanceradius>
        <cleanupradius>200</cleanupradius>
        <flags deletable="0" init_random="0" remove_damaged="1"/>
        <position>fixed</position>
        <limit>mixed</limit>
        <active>1</active>
        <children>
            <!-- Small groups of 1-3 hares, occasionally up to 5 -->
            <child lootmax="0" lootmin="0" max="3" min="1" type="Animal_Hare"/>
        </children>
    </event>

    <!-- ============================================================ -->
    <!-- ROE DEER — Very common prey, rural/forest                    -->
    <!-- Fields, forest clearings, meadows, village outskirts         -->
    <!-- ============================================================ -->
    <event name="AnimalRoeDeer">
        <nominal>50</nominal>
        <min>30</min>
        <max>70</max>
        <lifetime>3600</lifetime>
        <restock>0</restock>
        <saferadius>300</saferadius>
        <distanceradius>0</distanceradius>
        <cleanupradius>200</cleanupradius>
        <flags deletable="0" init_random="0" remove_damaged="1"/>
        <position>fixed</position>
        <limit>mixed</limit>
        <active>1</active>
        <children>
            <!-- Small groups 2-5, occasionally up to 6 in clearings -->
            <child lootmax="0" lootmin="0" max="5" min="2" type="Animal_RoeDeer"/>
        </children>
    </event>

    <!-- ============================================================ -->
    <!-- RED DEER — Common reward prey, inland meadows                -->
    <!-- Bigger animal, more meat — slightly harder to find           -->
    <!-- ============================================================ -->
    <event name="AnimalRedDeer">
        <nominal>35</nominal>
        <min>20</min>
        <max>50</max>
        <lifetime>3600</lifetime>
        <restock>0</restock>
        <saferadius>400</saferadius>
        <distanceradius>0</distanceradius>
        <cleanupradius>200</cleanupradius>
        <flags deletable="0" init_random="0" remove_damaged="1"/>
        <position>fixed</position>
        <limit>mixed</limit>
        <active>1</active>
        <children>
            <!-- Small herds 3-8, occasional large herd up to 10 -->
            <child lootmax="0" lootmin="0" max="8" min="3" type="Animal_RedDeer_Male"/>
            <child lootmax="0" lootmin="0" max="4" min="1" type="Animal_RedDeer_Female"/>
        </children>
    </event>

    <!-- ============================================================ -->
    <!-- WILD BOAR — Moderately common, woodland/forest               -->
    <!-- Forest floors, oak groves, farmland edges — they fight back  -->
    <!-- ============================================================ -->
    <event name="AnimalWildBoar">
        <nominal>30</nominal>
        <min>18</min>
        <max>45</max>
        <lifetime>3600</lifetime>
        <restock>0</restock>
        <saferadius>300</saferadius>
        <distanceradius>0</distanceradius>
        <cleanupradius>200</cleanupradius>
        <flags deletable="0" init_random="0" remove_damaged="1"/>
        <position>fixed</position>
        <limit>mixed</limit>
        <active>1</active>
        <children>
            <!-- Sounders of 3-8, large sounder up to 10 post-apocalypse -->
            <child lootmax="0" lootmin="0" max="8" min="3" type="Animal_WildBoar"/>
        </children>
    </event>

    <!-- ============================================================ -->
    <!-- HENS / CHICKENS — Common at settlements                      -->
    <!-- Every farm and village — easy early-game food                -->
    <!-- ============================================================ -->
    <event name="AnimalHen">
        <nominal>60</nominal>
        <min>35</min>
        <max>90</max>
        <lifetime>3600</lifetime>
        <restock>0</restock>
        <saferadius>150</saferadius>
        <distanceradius>0</distanceradius>
        <cleanupradius>150</cleanupradius>
        <flags deletable="0" init_random="0" remove_damaged="1"/>
        <position>fixed</position>
        <limit>mixed</limit>
        <active>1</active>
        <children>
            <!-- Small flocks 3-6, sometimes up to 8 at large farms -->
            <child lootmax="0" lootmin="0" max="6" min="3" type="Animal_Hen"/>
        </children>
    </event>

    <!-- ============================================================ -->
    <!-- CATTLE — Farms and open fields (some feral)                  -->
    <!-- Large meat reward — worth fighting over at farm locations     -->
    <!-- ============================================================ -->
    <event name="AnimalCow">
        <nominal>25</nominal>
        <min>12</min>
        <max>38</max>
        <lifetime>7200</lifetime>
        <restock>0</restock>
        <saferadius>400</saferadius>
        <distanceradius>0</distanceradius>
        <cleanupradius>200</cleanupradius>
        <flags deletable="0" init_random="0" remove_damaged="1"/>
        <position>fixed</position>
        <limit>mixed</limit>
        <active>1</active>
        <children>
            <!-- Small herds 2-5 per spawn point -->
            <child lootmax="0" lootmin="0" max="5" min="2" type="Animal_Cow"/>
        </children>
    </event>

    <!-- ============================================================ -->
    <!-- SHEEP & GOATS — Farms and hillsides                          -->
    <!-- Mixed flocks — some feral on hillsides post-apocalypse       -->
    <!-- ============================================================ -->
    <event name="AnimalSheepGoat">
        <nominal>20</nominal>
        <min>10</min>
        <max>32</max>
        <lifetime>7200</lifetime>
        <restock>0</restock>
        <saferadius>350</saferadius>
        <distanceradius>0</distanceradius>
        <cleanupradius>200</cleanupradius>
        <flags deletable="0" init_random="0" remove_damaged="1"/>
        <position>fixed</position>
        <limit>mixed</limit>
        <active>1</active>
        <children>
            <!-- Small flocks 3-6 -->
            <child lootmax="0" lootmin="0" max="6" min="3" type="Animal_Goat"/>
        </children>
    </event>

    <!-- ============================================================ -->
    <!-- PIGS — Mostly farms, some feral near forests                 -->
    <!-- Post-apocalypse some have escaped farms and gone wild        -->
    <!-- ============================================================ -->
    <event name="AnimalPig">
        <nominal>20</nominal>
        <min>10</min>
        <max>30</max>
        <lifetime>7200</lifetime>
        <restock>0</restock>
        <saferadius>300</saferadius>
        <distanceradius>0</distanceradius>
        <cleanupradius>200</cleanupradius>
        <flags deletable="0" init_random="0" remove_damaged="1"/>
        <position>fixed</position>
        <limit>mixed</limit>
        <active>1</active>
        <children>
            <!-- Groups 2-5 -->
            <child lootmax="0" lootmin="0" max="5" min="2" type="Animal_Pig"/>
        </children>
    </event>

    <!-- ============================================================ -->
    <!-- DOMESTIC ANIMALS — Mixed, near villages                      -->
    <!-- General domestic animal spawning for settlement atmosphere    -->
    <!-- ============================================================ -->
    <event name="AnimalDomestic">
        <nominal>25</nominal>
        <min>12</min>
        <max>38</max>
        <lifetime>7200</lifetime>
        <restock>0</restock>
        <saferadius>300</saferadius>
        <distanceradius>0</distanceradius>
        <cleanupradius>200</cleanupradius>
        <flags deletable="0" init_random="0" remove_damaged="1"/>
        <position>fixed</position>
        <limit>mixed</limit>
        <active>1</active>
        <children>
            <!-- Small mixed groups 2-4 -->
            <child lootmax="0" lootmin="0" max="4" min="2" type="Animal_Goat"/>
        </children>
    </event>

    <!-- ============================================================ -->
    <!-- FOXES — Forest edges and farms (hunt hares and hens)         -->
    <!-- Overlap deliberately with hen/hare territories               -->
    <!-- ============================================================ -->
    <event name="AnimalFox">
        <nominal>30</nominal>
        <min>18</min>
        <max>45</max>
        <lifetime>3600</lifetime>
        <restock>0</restock>
        <saferadius>250</saferadius>
        <distanceradius>0</distanceradius>
        <cleanupradius>200</cleanupradius>
        <flags deletable="0" init_random="0" remove_damaged="1"/>
        <position>fixed</position>
        <limit>mixed</limit>
        <active>1</active>
        <children>
            <!-- Solitary or pairs — foxes are mostly solo hunters -->
            <child lootmax="0" lootmin="0" max="3" min="1" type="Animal_Fox"/>
        </children>
    </event>

    <!-- ============================================================ -->
    <!-- WOLVES — PREDATOR: Entire map, mixed pack sizes              -->
    <!-- EXPANDED from vanilla (vanilla: nominal=8, far north only)   -->
    <!-- Mixed packs: small 2-3 scouts to large 8-12 mega-packs       -->
    <!-- Coastal wolves, forest packs, mountain packs — everywhere    -->
    <!-- ============================================================ -->
    <event name="AnimalWolf">
        <nominal>20</nominal>
        <min>12</min>
        <max>30</max>
        <lifetime>3600</lifetime>
        <restock>0</restock>
        <saferadius>500</saferadius>
        <distanceradius>0</distanceradius>
        <cleanupradius>300</cleanupradius>
        <flags deletable="0" init_random="0" remove_damaged="1"/>
        <position>fixed</position>
        <limit>mixed</limit>
        <active>1</active>
        <children>
            <!-- Mixed pack sizes: small scout packs (2-3) to large packs (8-12) -->
            <!-- Small scout packs — frequent, dangerous alone -->
            <child lootmax="0" lootmin="0" max="3" min="2" type="Animal_Wolf"/>
            <!-- Standard forest pack -->
            <child lootmax="0" lootmin="0" max="7" min="4" type="Animal_Wolf"/>
            <!-- Large pack — apex predator encounter -->
            <child lootmax="0" lootmin="0" max="12" min="8" type="Animal_Wolf"/>
        </children>
    </event>

    <!-- White wolves — northern forests and mountain ridges -->
    <event name="AnimalWolf_White">
        <nominal>8</nominal>
        <min>4</min>
        <max>12</max>
        <lifetime>3600</lifetime>
        <restock>0</restock>
        <saferadius>600</saferadius>
        <distanceradius>0</distanceradius>
        <cleanupradius>300</cleanupradius>
        <flags deletable="0" init_random="0" remove_damaged="1"/>
        <position>fixed</position>
        <limit>mixed</limit>
        <active>1</active>
        <children>
            <!-- Northern ghost packs — smaller but deadly -->
            <child lootmax="0" lootmin="0" max="5" min="2" type="Animal_Wolf_White"/>
        </children>
    </event>

    <!-- ============================================================ -->
    <!-- BEARS — PREDATOR: Map-wide, rivers/forests/food sources      -->
    <!-- EXPANDED from vanilla (vanilla: ~5-6 territories, far north) -->
    <!-- Bears near rivers, orchards, farms — they follow food        -->
    <!-- Post-apocalypse: bolder, ranging further south               -->
    <!-- ============================================================ -->
    <event name="AnimalBear">
        <nominal>15</nominal>
        <min>8</min>
        <max>22</max>
        <lifetime>7200</lifetime>
        <restock>0</restock>
        <saferadius>700</saferadius>
        <distanceradius>0</distanceradius>
        <cleanupradius>400</cleanupradius>
        <flags deletable="0" init_random="0" remove_damaged="1"/>
        <position>fixed</position>
        <limit>mixed</limit>
        <active>1</active>
        <children>
            <!-- Mostly solitary, occasionally a mother with 1-2 cubs -->
            <child lootmax="0" lootmin="0" max="2" min="1" type="Animal_Bear"/>
        </children>
    </event>

</events>
