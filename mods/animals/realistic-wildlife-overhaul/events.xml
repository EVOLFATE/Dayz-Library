<?xml version="1.0" encoding="UTF-8"?>
<!--
    events.xml — Realistic Wildlife Overhaul
    ==========================================
    Replacement events.xml for DayZ Chernarus+ (dayzOffline.chernarusplus).

    INSTALL PATH: mpmissions/dayzOffline.chernarusplus/db/events.xml

    All event names, parameters, children, and structure match vanilla
    BohemiaInteractive/DayZ-Central-Economy (dayzOffline.chernarusplus) exactly.
    Only nominal, min, and max values differ from vanilla — these control how
    many animals are active on the map at any time.

    NOMINAL COUNTS (vanilla in parentheses):
      AmbientFox     30  (vanilla  0) — forest edges and fields
      AmbientHare    80  (vanilla  0) — most common prey, everywhere
      AmbientHen     60  (vanilla  3) — settlements and farms
      AnimalBear     15  (vanilla  0) — apex predator, rivers and forests
      AnimalCow      25  (vanilla  7) — farms and open fields
      AnimalDeer     35  (vanilla  9) — inland meadows and river valleys
      AnimalGoat     10  (vanilla  8) — farms and hillsides
      AnimalPig      20  (vanilla  6) — farms and forest edges
      AnimalRoeDeer  50  (vanilla 10) — very common, rural and forest
      AnimalSheep    10  (vanilla  5) — farms and hillsides
      AnimalWildBoar 30  (vanilla  7) — woodlands and farmland edges
      AnimalWolf     20  (vanilla  8) — predator, grey and white packs
-->
<events>

    <!-- AmbientFox, AmbientHare, AmbientHen: proximity-based ambient events.
         Spawn near players using distanceradius. No territory file required. -->

    <event name="AmbientFox">
        <nominal>30</nominal>
        <min>0</min>
        <max>45</max>
        <lifetime>33</lifetime>
        <restock>25</restock>
        <saferadius>0</saferadius>
        <distanceradius>80</distanceradius>
        <cleanupradius>120</cleanupradius>
        <flags deletable="0" init_random="0" remove_damaged="0"/>
        <position>fixed</position>
        <limit>mixed</limit>
        <active>1</active>
        <children>
            <child lootmax="0" lootmin="0" max="0" min="100" type="Animal_VulpesVulpes"/>
        </children>
    </event>

    <event name="AmbientHare">
        <nominal>80</nominal>
        <min>0</min>
        <max>120</max>
        <lifetime>33</lifetime>
        <restock>30</restock>
        <saferadius>0</saferadius>
        <distanceradius>20</distanceradius>
        <cleanupradius>40</cleanupradius>
        <flags deletable="0" init_random="0" remove_damaged="0"/>
        <position>fixed</position>
        <limit>mixed</limit>
        <active>1</active>
        <children>
            <child lootmax="0" lootmin="0" max="0" min="100" type="Animal_LepusEuropaeus"/>
        </children>
    </event>

    <event name="AmbientHen">
        <nominal>60</nominal>
