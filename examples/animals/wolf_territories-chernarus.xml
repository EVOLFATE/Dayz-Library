<!--
    Wolf Territories - Chernarus
    ==============================
    PURPOSE : Adds wolf spawn zones across the entire Chernarus map.
              Wolves patrol the coastline, lurk near towns, and form
              large dangerous packs in remote wilderness areas.

    USAGE   : Drop this file into your mpmissions/dayzOffline.chernarusplus/env/
              folder. DayZ loads all zombie_territories*.xml files automatically,
              but this file uses territory-type directly and must be placed where
              your server loads animal territory files.
              Rename to match your server's animal territory filename convention
              (e.g., animal_territories.xml or wolf_territories.xml).

    ZONE NAME : "Wolf" — the official DayZ animal class name for wolves.

    DESIGN GOALS:
      - Coastal wolves  : Small roaming packs (1–3), radius 150–250 m
                          Spawn along southern and eastern shorelines
      - Near-town wolves: Lurking packs (2–4), radius 150–200 m
                          Forest edges and outskirts, never inside towns
      - Wilderness packs: Large dangerous packs (6–15+), radius 300–500 m
                          Remote forests, hills, and wilderness across the map
                          Some zones use smin/smax for conditional activation

    TERRITORY COLORS:
      1090519039  — Coastal wolves  (blue-toned)
      4278255615  — Near-town wolves (yellow/amber)
      4278190335  — Wilderness packs (red/orange)

    COORDINATE SYSTEM:
      x = east–west  (0 = far west, ~15360 = far east)
      z = north–south (0 = far south coast, ~15360 = far north)

    ATTRIBUTE REFERENCE:
      smin/smax = min/max survivors (players) needed to activate zone
                  0/0 = always active regardless of player count
      dmin/dmax = min/max wolves that can spawn in the zone per cycle
      r         = radius in metres
-->
<territory-type>

    <!-- ============================================================ -->
    <!-- COASTAL WOLVES                                                -->
    <!-- Small roaming packs stalking beaches, cliffs, and docks      -->
    <!-- along the southern and eastern coastline of Chernarus.       -->
    <!-- color=1090519039 (blue-toned)                                -->
    <!-- dmin="1" dmax="3"  |  r=150–250                              -->
    <!-- ============================================================ -->
    <territory color="1090519039">

        <!-- Kamenka coast -->
        <zone name="Wolf" smin="0" smax="0" dmin="1" dmax="3" x="421" z="2345" r="200"/>
        <zone name="Wolf" smin="0" smax="0" dmin="1" dmax="2" x="680" z="2180" r="150"/>

        <!-- Komarovo coast -->
